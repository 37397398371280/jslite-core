{
  "name": "jslite-core",
  "version": "1.0.1",
  "description": "Zero-dependency JavaScript lite utility package designed to run from ES3 through ES2026.",
  "main": "./lite.cjs.js",
  "module": "./lite.esm.mjs",
  "types": "./index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/37397398371280/jslite-core.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lite.esm.mjs",
      "require": "./lite.cjs.js",
      "default": "./lite.cjs.js"
    }
  },
  "files": [
    "lite.cjs.js",
    "lite.esm.mjs",
    "index.d.ts",
    "docs.html",
    "readme.md",
    "LICENSE"
  ],
  "keywords": [
    "lite",
    "utility",
    "es3",
    "es2026",
    "universal",
    "zero-dependency"
  ],
  "license": "GPL-3.0"
}
